# HTTP порт (на хостингах обычно выставляется автоматически, например Render/Railway)
PORT=3000
HOST=0.0.0.0

# Уровень логов: debug | info | warn | error
LOG_LEVEL=info

# Комнаты и матчмейкинг
DEFAULT_CAPACITY=2
MIN_CAPACITY=2
MAX_CAPACITY=8
ROOM_CODE_LENGTH=4

# Таймауты (мс)
FILL_TIMEOUT_MS=30000
QUEUE_TIMEOUT_MS=60000
IDLE_CLOSE_MS=15000
MAX_MESSAGE_LENGTH=500

# База данных (SQLite). В контейнере — смонтированный том.
DB_PATH=./data/server.db

# Игра
MATCH_DURATION_MS=180000
GAME_TICK_MS=33
STATE_SEND_EVERY_TICKS=2

# Режим разработки: GOD_MODE=1 делает игроков неуязвимыми (проверка боссов/врагов).
# Значения: 1 | true | yes | on. В соло-режиме включается ?godMode=1 в адресе.
# GOD_MODE=1
